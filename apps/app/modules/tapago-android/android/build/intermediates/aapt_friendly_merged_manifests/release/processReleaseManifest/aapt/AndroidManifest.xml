<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="expo.modules.tapagoandroid" >

    <uses-sdk android:minSdkVersion="24" />

    <application>

        <!-- Widget da tela inicial: saldo, o dia e o timer. Atualizado pelo app, sem servidor. -->
        <receiver
            android:name="expo.modules.tapagoandroid.BalanceWidget"
            android:exported="false"
            android:label="@string/tapago_widget_label" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tapago_widget_info" />
        </receiver>
    </application>

</manifest>