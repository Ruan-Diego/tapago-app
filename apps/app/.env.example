# Copie para apps/app/.env e preencha.
# Config do app Web: `firebase apps:sdkconfig WEB` ou Console → Configurações do projeto.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# OAuth client ID do tipo "Web" (Google Sign-In). Está no google-services.json, client_type 3.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# true: usa o Firebase Emulator Suite local (`pnpm emulators`) em vez do projeto real.
EXPO_PUBLIC_USE_EMULATOR=false
# Só para celular físico com emulador: IP do computador na rede local.
# EXPO_PUBLIC_EMULATOR_HOST=192.168.0.10

# O Android também precisa de apps/app/google-services.json (fora do git).
