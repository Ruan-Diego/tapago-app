rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Faixas iguais às de `LIMITS` em packages/core.
    function validName(name) {
      return name is string && name.size() >= 1 && name.size() <= 60;
    }
    function validValue(value) {
      return value is int && value >= 1 && value <= 1000000;
    }
    function validMinutes(minutes) {
      return minutes is int && minutes >= 1 && minutes <= 1440;
    }
    function validId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    function hasShape(data, required, optional) {
      return data.keys().hasAll(required) && data.keys().hasOnly(required.concat(optional));
    }

    function validHabitTarget(target) {
      return target is int && target >= 1 && target <= 20;
    }
    function validDay(day) {
      return day is string && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validHabit(habit) {
      return hasShape(habit, ['target', 'bonus'], [])
        && validHabitTarget(habit.target)
        && validValue(habit.bonus);
    }

    function validStreak(streak) {
      return hasShape(streak, ['days', 'lastDay'], [])
        && streak.days is int && streak.days >= 1
        && validDay(streak.lastDay);
    }

    // Hábito, aumento e sequência são só das positivas; a contagem, só das negativas.
    function validActivity(data) {
      return hasShape(data,
          ['name', 'description', 'kind', 'value', 'minutes', 'order', 'archived', 'createdAt'],
          ['habit', 'streakStep', 'streak', 'penaltyCount'])
        && (data.kind == 'positive' || !data.keys().hasAny(['habit', 'streakStep', 'streak']))
        && (data.kind == 'negative' || !('penaltyCount' in data))
        && (!('habit' in data) || validHabit(data.habit))
        && (!('streak' in data) || validStreak(data.streak))
        && data.get('streakStep', 0) is int
        && data.get('streakStep', 0) >= 0 && data.get('streakStep', 0) <= 1000000
        && data.get('penaltyCount', 0) is int
        && data.get('penaltyCount', 0) >= 0
        && validName(data.name)
        && data.description is string && data.description.size() <= 140
        && data.kind in ['positive', 'negative']
        && validValue(data.value)
        && validMinutes(data.minutes)
        && data.order is number
        && data.archived is bool
        && data.createdAt is timestamp;
    }

    function validShopItem(data) {
      return hasShape(data, ['name', 'value', 'minutes', 'order', 'archived', 'createdAt'], [])
        && validName(data.name)
        && validValue(data.value)
        && validMinutes(data.minutes)
        && data.order is number
        && data.archived is bool
        && data.createdAt is timestamp;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }
    function activityPath(uid, id) {
      return /databases/$(database)/documents/users/$(uid)/activities/$(id);
    }
    function entryPath(uid, id) {
      return /databases/$(database)/documents/users/$(uid)/entries/$(id);
    }
    function dailyPath(uid, day) {
      return /databases/$(database)/documents/users/$(uid)/daily/$(day);
    }

    // O saldo muda, no mesmo lote, exatamente pelo valor do lançamento. Por isso o app grava um
    // único lançamento que mexe no saldo por lote. Limite conhecido: as regras olham um documento
    // por vez e não percebem dois lançamentos de mesmo valor dividindo uma só mudança.
    function movesBalance(uid, amount) {
      return getAfter(userPath(uid)).data.balance == get(userPath(uid)).data.balance + amount;
    }

    // O valor calculado nunca passa do teto de um lançamento (R16).
    function capped(value) {
      return value > 1000000 ? 1000000 : value;
    }

    /**
     * O valor de um ganho (R14): o inicial mais o aumento pelos dias anteriores. O nível é o que a
     * atividade passa a guardar na sequência, e não passa do dia seguinte ao que ela tinha.
     */
    function chargesPositive(uid, data) {
      let before = get(activityPath(uid, data.refId)).data;
      let after = getAfter(activityPath(uid, data.refId)).data;
      return before.kind == 'positive'
        && data.base == before.value
        && data.value == capped(data.base + before.get('streakStep', 0) * (data.level - 1))
        && after.streak.days == data.level
        && (data.level == 1 || ('streak' in before && data.level <= before.streak.days + 1));
    }

    /**
     * O custo de uma negativa (R15). Dois aparelhos sem internet podem cobrar o mesmo nível, mas
     * nunca um acima do próximo.
     */
    function chargesNegative(uid, data) {
      let before = get(activityPath(uid, data.refId)).data;
      let after = getAfter(activityPath(uid, data.refId)).data;
      let count = before.get('penaltyCount', 0);
      return before.kind == 'negative'
        && data.base == before.value
        && data.value == capped(data.base * data.level)
        && data.level <= count + 1
        && after.penaltyCount == count + 1;
    }

    // A versão do app anterior à F6 não grava `base` nem `level`: cobra o valor da atividade.
    function chargesActivity(uid, data) {
      return !('level' in data)
        ? get(activityPath(uid, data.refId)).data.value == data.value
          && get(activityPath(uid, data.refId)).data.kind
            == (data.type == 'earn' ? 'positive' : 'negative')
        : (data.type == 'earn' ? chargesPositive(uid, data) : chargesNegative(uid, data));
    }

    // A compra cobra o preço do item e não deixa o saldo negativo (R3).
    function paysPurchase(uid, data) {
      return get(/databases/$(database)/documents/users/$(uid)/shopItems/$(data.refId)).data.value
          == data.value
        && movesBalance(uid, -data.value)
        && getAfter(userPath(uid)).data.balance >= 0;
    }

    /** O efeito de cada tipo no saldo. O uso não mexe nele: a compra já pagou. */
    function booksEntry(uid, data) {
      return data.type == 'use'
        || (data.type == 'purchase' && paysPurchase(uid, data))
        || (data.type == 'earn' && chargesActivity(uid, data) && movesBalance(uid, data.value))
        || (data.type == 'loss' && chargesActivity(uid, data) && movesBalance(uid, -data.value));
    }

    function validEntry(data) {
      return hasShape(data,
          ['type', 'refId', 'name', 'value', 'minutes', 'at', 'deviceId'],
          ['base', 'level'])
        && data.type in ['earn', 'loss', 'purchase', 'use']
        // O valor inicial e o nível explicam um ganho ou uma perda (R14, R15). São opcionais
        // porque a versão anterior do app não os grava.
        && (!data.keys().hasAny(['base', 'level'])
          || (data.type in ['earn', 'loss']
            && data.keys().hasAll(['base', 'level'])
            && validValue(data.base)
            && data.level is int && data.level >= 1))
        && validId(data.refId)
        && validName(data.name)
        && validValue(data.value)
        && validMinutes(data.minutes)
        && data.at is timestamp
        && validId(data.deviceId);
    }

    /**
     * Um id de bônus: `base` no primeiro pagamento; depois de estornado, `base_1`, `base_2`… Só
     * vale o seguinte quando o anterior já foi estornado. Gravar um id repetido conta como mudar
     * um lançamento, o que as regras recusam: cada bônus sai uma vez.
     */
    function isBonusAttempt(uid, id, base) {
      let rest = id.size() > base.size() ? id[base.size():id.size()] : '';
      let attempt = rest.matches('^_[1-9][0-9]{0,2}$') ? int(rest[1:rest.size()]) : 0;
      let previous = attempt > 1 ? base + '_' + string(attempt - 1) : base;
      return id == base
        || (attempt > 0 && id == base + rest && exists(entryPath(uid, 'undo_' + previous)));
    }

    /**
     * O bônus de hábito (R13): sem tempo, com o id do dia, o valor e a meta da atividade, e só
     * com a meta batida no dia.
     */
    function validHabitBonus(uid, data, id) {
      let prefix = 'habit_' + data.refId + '_';
      let day = id.size() >= prefix.size() + 10
        ? id[prefix.size():prefix.size() + 10] : '';
      let activity = get(activityPath(uid, data.refId)).data;
      return hasShape(data, ['type', 'refId', 'name', 'value', 'minutes', 'at', 'deviceId',
          'source', 'target'], [])
        && data.source == 'habit'
        && validId(data.refId)
        && validName(data.name)
        && validValue(data.value)
        && data.minutes is int && data.minutes == 0
        && data.at is timestamp
        && validId(data.deviceId)
        && validHabitTarget(data.target)
        && validDay(day)
        && isBonusAttempt(uid, id, prefix + day)
        && activity.kind == 'positive'
        && data.value == activity.habit.bonus
        && data.target == activity.habit.target
        && getAfter(dailyPath(uid, day)).data.counts.get(data.refId, 0) >= data.target
        && movesBalance(uid, data.value);
    }

    // O bônus da missão (R18), em centavos.
    function isMissionBonus(value) {
      return value is int && value == 10000;
    }

    function validMissionActivity(item) {
      return hasShape(item, ['id', 'name'], [])
        && validId(item.id)
        && validName(item.name);
    }

    // Duas atividades diferentes (R17).
    function validMissionActivities(list) {
      return list is list && list.size() == 2
        && validMissionActivity(list[0])
        && validMissionActivity(list[1])
        && list[0].id != list[1].id;
    }

    function validMission(data, day) {
      return hasShape(data, ['date', 'activities', 'bonus', 'createdAt'], [])
        && validDay(day)
        && data.date == day
        && validMissionActivities(data.activities)
        && isMissionBonus(data.bonus)
        && data.createdAt is timestamp;
    }

    function missionPath(uid, day) {
      return /databases/$(database)/documents/users/$(uid)/missions/$(day);
    }

    function missionBonusId(day, reversals) {
      return reversals > 0 ? 'mission_' + day + '_' + string(reversals) : 'mission_' + day;
    }

    /**
     * O bônus da missão: id do dia, com as mesmas atividades da missão gravada, as duas já
     * registradas, e no mesmo lote que a marca como cumprida. Um aparelho que sorteou outro par
     * não paga.
     */
    function validMissionBonus(uid, data, id) {
      let mission = getAfter(missionPath(uid, data.refId)).data;
      let daily = getAfter(dailyPath(uid, data.refId)).data;
      return hasShape(data, ['type', 'refId', 'name', 'value', 'minutes', 'at', 'deviceId',
          'source', 'activities'], [])
        && data.source == 'mission'
        && validDay(data.refId)
        && id == missionBonusId(data.refId, mission.get('reversals', 0))
        && validName(data.name)
        && isMissionBonus(data.value)
        && data.minutes is int && data.minutes == 0
        && data.at is timestamp
        && validId(data.deviceId)
        && data.activities == mission.activities
        && mission.completedAt == data.at
        && daily.counts.get(data.activities[0].id, 0) >= 1
        && daily.counts.get(data.activities[1].id, 0) >= 1
        && movesBalance(uid, data.value);
    }

    function validBonus(uid, data, id) {
      return data.get('source', '') == 'mission'
        ? validMissionBonus(uid, data, id)
        : validHabitBonus(uid, data, id);
    }

    /**
     * Desfazer (R8): um lançamento novo, com o id `undo_{original}`, que copia um registro ou um
     * bônus e devolve exatamente o valor dele. O mesmo não é desfeito duas vezes.
     */
    function validReversal(uid, data, id) {
      let original = get(entryPath(uid, data.reverses)).data;
      return hasShape(data, ['type', 'reversedType', 'reverses', 'refId', 'name', 'value',
          'minutes', 'at', 'deviceId'], [])
        && validId(data.reverses)
        && id == 'undo_' + data.reverses
        && original.type in ['earn', 'loss', 'bonus']
        && data.reversedType == original.type
        && data.refId == original.refId
        && data.name == original.name
        && data.value == original.value
        && data.minutes == original.minutes
        && data.at is timestamp
        && validId(data.deviceId)
        // O bônus de missão só é estornado reabrindo a missão no mesmo lote.
        && (original.get('source', '') != 'mission'
          || !('completedAt' in getAfter(missionPath(uid, original.refId)).data))
        && movesBalance(uid, original.type == 'loss' ? original.value : -original.value);
    }

    function validNewEntry(uid, data, id) {
      return data.type == 'bonus' ? validBonus(uid, data, id)
        : data.type == 'reversal' ? validReversal(uid, data, id)
        : validEntry(data) && booksEntry(uid, data);
    }

    /** Trocar a atividade arquivada de uma missão ainda não cumprida. */
    function replacesMissionActivities() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activities'])
        && validMissionActivities(request.resource.data.activities);
    }

    /** Cumprir: só junto com o lançamento do bônus. */
    function completesMission(uid, day) {
      let id = missionBonusId(day, resource.data.get('reversals', 0));
      return !('completedAt' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedAt'])
        && request.resource.data.completedAt is timestamp
        && getAfter(entryPath(uid, id)).data.at == request.resource.data.completedAt;
    }

    /** Reabrir: só junto com o estorno do bônus pago. */
    function reopensMission(uid, day) {
      let reversals = resource.data.get('reversals', 0);
      let undo = entryPath(uid, 'undo_' + missionBonusId(day, reversals));
      return 'completedAt' in resource.data
        && !('completedAt' in request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['completedAt', 'reversals'])
        && request.resource.data.reversals == reversals + 1
        && !exists(undo)
        && existsAfter(undo);
    }

    function sessionPath(uid) {
      return /databases/$(database)/documents/users/$(uid)/state/session;
    }

    /** A única mudança aceita em um lançamento: os minutos realmente usados de um `use`. */
    function isUseMinutesOnly() {
      return resource.data.type == 'use'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['minutes'])
        && validMinutes(request.resource.data.minutes);
    }

    /**
     * Os minutos só são gravados ao encerrar a sessão atual, no mesmo lote que a apaga. Assim, um
     * aparelho desatualizado não encerra de novo (nem conta de novo no dia) um uso já fechado.
     */
    function closesCurrentSession(uid, entryId) {
      return get(sessionPath(uid)).data.useEntryId == entryId
        && !existsAfter(sessionPath(uid));
    }

    function validSession(data) {
      return hasShape(data, ['id', 'status', 'itemName', 'totalMs', 'startedAt', 'endsAt',
          'remainingMs', 'useEntryId', 'originDevice'], [])
        && validId(data.id)
        && data.status in ['running', 'paused']
        && validName(data.itemName)
        && data.totalMs is int && data.totalMs > 0 && data.totalMs <= 86400000
        && data.startedAt is timestamp
        && data.endsAt is timestamp
        && data.remainingMs is int && data.remainingMs >= 0 && data.remainingMs <= data.totalMs
        && validId(data.useEntryId)
        && validId(data.originDevice);
    }

    // `leftFrom` só no resto de um uso guardado para depois: a duração original, nunca menor que
    // o que sobrou.
    function validInventoryItem(data) {
      return hasShape(data,
          ['shopItemId', 'name', 'value', 'minutes', 'purchaseEntryId', 'purchasedAt'],
          ['leftFrom'])
        && validId(data.shopItemId)
        && validName(data.name)
        && validValue(data.value)
        && validMinutes(data.minutes)
        && validId(data.purchaseEntryId)
        && data.purchasedAt is timestamp
        && (!('leftFrom' in data)
          || (validMinutes(data.leftFrom) && data.leftFrom >= data.minutes));
    }

    // Cada escrita traz só os campos que mudaram; os outros podem nem existir.
    function validDaily(data, day) {
      return hasShape(data, ['date'], ['earned', 'lost', 'spent', 'posMin', 'negMin',
          'leisureMin', 'posCount', 'negCount', 'buyCount', 'counts', 'bonuses', 'undone'])
        && validDay(day)
        && data.date == day
        && data.get('earned', 0) is int
        && data.get('lost', 0) is int
        && data.get('spent', 0) is int
        && data.get('posMin', 0) is int
        && data.get('negMin', 0) is int
        && data.get('leisureMin', 0) is int
        && data.get('posCount', 0) is int
        && data.get('negCount', 0) is int
        && data.get('buyCount', 0) is int
        && data.get('counts', {}) is map
        && data.get('bonuses', {}) is map
        && data.get('undone', {}) is map;
    }

    // O lembrete diário (F5) é opcional: a versão anterior do app grava só os três primeiros.
    function validNotif(notif) {
      return hasShape(notif, ['end', 'warn5', 'weekly'], ['daily', 'dailyHour'])
        && notif.end is bool
        && notif.warn5 is bool
        && notif.weekly is bool
        && notif.get('daily', false) is bool
        && notif.get('dailyHour', 20) is int
        && notif.get('dailyHour', 20) >= 0 && notif.get('dailyHour', 20) <= 23;
    }

    function validUser(data) {
      return data.name is string && data.name.size() <= 60
        && data.balance is int
        && data.get('bio', '') is string && data.get('bio', '').size() <= 140
        && data.get('weeklyGoal', 0) is int
        && data.get('weeklyGoal', 0) >= 0 && data.get('weeklyGoal', 0) <= 10000000
        && data.get('onboardingDone', false) is bool
        && data.get('deleting', false) is bool
        && (!('notif' in data) || validNotif(data.notif));
    }

    /**
     * Excluir a conta (F5): a marca `deleting` libera apagar os dados, e não volta atrás. Fora
     * disso, nada da conta é apagado.
     */
    function isClosing(uid) {
      return get(userPath(uid)).data.get('deleting', false) == true;
    }
    function keepsClosing() {
      return resource.data.get('deleting', false) == false
        || request.resource.data.get('deleting', false) == true;
    }

    // Foto de perfil em base64 (menos de 150 KB), sem Storage.
    function validAvatar(data) {
      return hasShape(data, ['data', 'updatedAt'], [])
        && data.data is string && data.data.size() >= 1 && data.data.size() <= 200000
        && data.updatedAt is timestamp;
    }

    // Cada usuário só lê e escreve nos próprios dados. Todo o resto é negado: um caminho novo
    // precisa de um bloco próprio aqui.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validUser(request.resource.data);
      allow update: if isOwner(uid) && validUser(request.resource.data) && keepsClosing();
      // O último passo da exclusão da conta, depois de apagados os dados.
      allow delete: if isOwner(uid) && resource.data.get('deleting', false) == true;

      // Arquivar em vez de apagar (R10). Só se apaga ao excluir a conta.
      match /activities/{id} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validActivity(request.resource.data);
        allow delete: if isOwner(uid) && isClosing(uid);
      }

      match /shopItems/{id} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validShopItem(request.resource.data);
        allow delete: if isOwner(uid) && isClosing(uid);
      }

      // Livro-caixa: só inclusão. Só se apaga ao excluir a conta.
      match /entries/{id} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validNewEntry(uid, request.resource.data, id);
        allow update: if isOwner(uid) && isUseMinutesOnly() && closesCurrentSession(uid, id);
        allow delete: if isOwner(uid) && isClosing(uid);
      }

      // Apagado quando o uso começa. Apagar um item que já saiu derruba o lote inteiro, então o
      // mesmo item não é usado duas vezes.
      match /inventory/{id} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validInventoryItem(request.resource.data);
        allow update: if false;
        allow delete: if isOwner(uid) && resource != null;
      }

      // Um timer por vez (R5): o documento é único, e começar outro por cima conta como mudar a
      // sessão, o que as regras recusam.
      match /state/session {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && validSession(request.resource.data)
          && request.resource.data.status == 'running'
          && getAfter(/databases/$(database)/documents/users/$(uid)/entries/$(request.resource.data.useEntryId)).data.type == 'use';
        // Pausar e retomar.
        allow update: if isOwner(uid)
          && validSession(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'endsAt', 'remainingMs']);
        allow delete: if isOwner(uid) && resource != null;
      }

      match /avatar/{id} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && id == 'current'
          && validAvatar(request.resource.data);
        allow delete: if isOwner(uid) && isClosing(uid);
      }

      // A missão do dia. A primeira gravada vale: gravar por cima conta como mudar, e só se
      // troca o par, se marca como cumprida ou se reabre ao estornar o bônus.
      match /missions/{day} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validMission(request.resource.data, day);
        allow update: if isOwner(uid)
          && ((!('completedAt' in resource.data) && replacesMissionActivities())
            || completesMission(uid, day)
            || reopensMission(uid, day));
        allow delete: if isOwner(uid) && isClosing(uid);
      }

      match /daily/{day} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validDaily(request.resource.data, day);
        allow delete: if isOwner(uid) && isClosing(uid);
      }
    }
  }
}
